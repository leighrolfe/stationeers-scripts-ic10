# This script aims all solar panel types at the sun using a daylight sensor on d0.

# Manually set these values to match your daylight sensor orientation
define HorizontalOffset 0
define VerticalOffset 0 # Wall sensor = 0 | Flat (roof) sensor = 90

# All programmable solar panel types (type hash for sb group writes)
# Standard solar panels
define SolarPanelType01 HASH("StructureSolarPanel")
define SolarPanelType02 HASH("StructureSolarPanelDual")
define SolarPanelType03 HASH("StructureSolarPanel1x5")
define SolarPanelType04 HASH("StructureSolarPanel1x5Single")

# Heavy solar panels
define SolarPanelType05 HASH("StructureSolarPanelReinforced")
define SolarPanelType06 HASH("StructureSolarPanelDualReinforced")
define SolarPanelType07 HASH("StructureSolarPanel1x5Reinforced")
define SolarPanelType08 HASH("StructureSolarPanel1x5ReinforcedSingle")

define MaxAngle 360

# Set the daylight sensor device in the housing
alias DaylightSensor d0

# Registers
alias TargetHorizontal r0
alias TargetVertical r1
alias TmpRegister01 r14
alias TmpRegister02 r15

# Read the sensor, apply offsets, and run each tick
main:
yield

jal readSensor
jal setPanels

j main

# Read sensor and compute target angles
readSensor:
# Set horizontal target
l TmpRegister01 DaylightSensor Horizontal
add TmpRegister02 TmpRegister01 HorizontalOffset
mod TargetHorizontal TmpRegister02 MaxAngle

# Set vertical target
l TmpRegister01 DaylightSensor Vertical
add TargetVertical TmpRegister01 VerticalOffset

j ra

# Write computed angles to all panel types
setPanels:
sb SolarPanelType01 Horizontal TargetHorizontal
sb SolarPanelType01 Vertical TargetVertical
sb SolarPanelType02 Horizontal TargetHorizontal
sb SolarPanelType02 Vertical TargetVertical
sb SolarPanelType03 Horizontal TargetHorizontal
sb SolarPanelType03 Vertical TargetVertical
sb SolarPanelType04 Horizontal TargetHorizontal
sb SolarPanelType04 Vertical TargetVertical
sb SolarPanelType05 Horizontal TargetHorizontal
sb SolarPanelType05 Vertical TargetVertical
sb SolarPanelType06 Horizontal TargetHorizontal
sb SolarPanelType06 Vertical TargetVertical
sb SolarPanelType07 Horizontal TargetHorizontal
sb SolarPanelType07 Vertical TargetVertical
sb SolarPanelType08 Horizontal TargetHorizontal
sb SolarPanelType08 Vertical TargetVertical

j ra
