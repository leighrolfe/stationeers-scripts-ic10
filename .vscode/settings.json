    ],
    "editor.semanticHighlighting.enabled": true,
    "editor.semanticTokenColorCustomizations": {
        "enabled": true,
        "rules": {
            // "device": "#FD3DB5",
            // "register": "#FD3DB5",
            "keyword": "#33691E",
            // "keyword.declaration": "#FD3DB5",
            "variable": "#01579B",
