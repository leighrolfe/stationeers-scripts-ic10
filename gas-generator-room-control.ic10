# Gas fuel generator room climate and fuel pressure control with deadzone-based hysteresis

# Device Aliases
alias TempSensor d0
alias PressureRegulator d1
alias GasGenerator d2
alias VentIn d3
alias VentOut d4
alias RoomHeater d5

# Register Aliases
alias CurrentTemp r0
alias FanStatus r1
alias HeaterStatus r2
alias GeneratorStatus r3
alias CurrentPressure r4
alias PressureDelta1 r5
alias PressureDelta2 r6
alias BatteriesCharge r7
alias TmpRegister1 r14
alias TmpRegister2 r15

# Constants
define MinTemp 274.15 # 1 C
define MaxPressure 45 # kPa
define MinPressure 5 # kPa
define DeadzoneLow 293.15 # 20 C
define DeadzoneHigh 313.15 # 40 C

define BatteriesNetwork HASH("StructureBattery")
define MaxBatteryCharge 0.95 # 95% charge max

# Initialise pressure to minimum
move CurrentPressure MinPressure

# Main loop
main:
yield

l CurrentTemp TempSensor Temperature

jal setHeaters
jal setFans
jal setPressure
jal setGenerator

sleep 1
j main

# Raise temperature to operational range for gas generator
setHeaters:
sgt HeaterStatus MinTemp CurrentTemp
s RoomHeater On HeaterStatus
j ra

# Turn fans on above deadzone, off below, hold in between
setFans:
l FanStatus VentIn On
select TmpRegister1 FanStatus DeadzoneHigh DeadzoneLow # If fan is on use max temp, else store min temp
sge FanStatus CurrentTemp TmpRegister1
s VentIn On FanStatus
s VentOut On FanStatus
j ra

# Hold pressure within deadzone, ramp outside it, clamp to bounds
setPressure:
slt PressureDelta1 CurrentTemp DeadzoneLow # 1 if temp below deadzone, else 0
sgt TmpRegister1 CurrentTemp DeadzoneHigh # 1 if temp above deadzone, else 0
sub PressureDelta2 PressureDelta1 TmpRegister1 # delta: 1 (cold), -1 (hot), 0 (deadzone)
add CurrentPressure CurrentPressure PressureDelta2 # apply ramp

slt TmpRegister1 CurrentPressure MinPressure # 1 if pressure below floor, else 0
select CurrentPressure TmpRegister1 MinPressure CurrentPressure # floor to MinPressure if below

sgt TmpRegister1 CurrentPressure MaxPressure # 1 if pressure above ceiling, else 0
select CurrentPressure TmpRegister1 MaxPressure CurrentPressure # ceil to MaxPressure if above

s PressureRegulator Setting CurrentPressure # apply to device
j ra

# Start generator once above minimum temperature if batteries are not above a certain charge
setGenerator:
lb BatteriesCharge BatteriesNetwork Ratio Average # 0.0–1.0 - If no batteries on the network, remove the battery checks or rewrite to handle it properly

sgt TmpRegister1 CurrentTemp MinTemp # Is above min temp?
slt TmpRegister2 BatteriesCharge MaxBatteryCharge # Is below max battery charge?
and GeneratorStatus TmpRegister1 TmpRegister2  # ON only if temp OK AND batteries not at limit

s GasGenerator On GeneratorStatus
j ra
